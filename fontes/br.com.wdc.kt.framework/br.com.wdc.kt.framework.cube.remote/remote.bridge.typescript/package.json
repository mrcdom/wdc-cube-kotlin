{
  "name": "wdc-cube-remote-bridge",
  "version": "0.5.0",
  "description": "Client of the remote Cube MVP protocol, with no UI technology: session, handshake, WebSocket, scopes and events",
  "author": "Marcelo Domingos <WeDoCode Consultoria LTDA>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcdom/wdc-cube-kotlin.git",
    "directory": "fontes/br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript"
  },
  "homepage": "https://github.com/mrcdom/wdc-cube-kotlin/tree/main/fontes/br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript#readme",
  "bugs": {
    "url": "https://github.com/mrcdom/wdc-cube-kotlin/issues"
  },
  "keywords": [
    "cube",
    "wdc-cube",
    "remote",
    "presenter",
    "websocket",
    "bridge"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "npm run build && node ../scripts/copy-license.mjs",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "history": "^5.3.0",
    "universal-cookie": "^7.2.2"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "history": "5.3.0",
    "jsdom": "26.1.0",
    "prettier": "^3.8.2",
    "typescript": "5.7.3",
    "typescript-eslint": "8.72.2",
    "universal-cookie": "7.2.2",
    "vitest": "3.2.4"
  }
}
