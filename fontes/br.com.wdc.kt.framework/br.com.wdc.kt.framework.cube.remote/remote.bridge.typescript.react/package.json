{
  "name": "wdc-cube-remote-bridge-react",
  "version": "0.5.0",
  "description": "React bindings for the client of the remote Cube MVP protocol",
  "author": "Marcelo Domingos <WeDoCode Consultoria LTDA>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mrcdom/wdc-cube-kotlin.git",
    "directory": "fontes/br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript.react"
  },
  "homepage": "https://github.com/mrcdom/wdc-cube-kotlin/tree/main/fontes/br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript.react#readme",
  "bugs": {
    "url": "https://github.com/mrcdom/wdc-cube-kotlin/issues"
  },
  "keywords": [
    "cube",
    "wdc-cube",
    "remote",
    "react",
    "presenter",
    "bridge"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "files": [
    "lib",
    "src",
    "LICENSE",
    "README.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "npm --prefix ../remote.bridge.typescript run build && tsc -p tsconfig.build.json",
    "prepack": "npm run build && node ../scripts/copy-license.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --deny-warnings"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "wdc-cube-remote-bridge": "^0.5.0"
  },
  "devDependencies": {
    "@types/react": "19.2.2",
    "history": "5.3.0",
    "oxlint": "1.93.0",
    "prettier": "^3.8.2",
    "react": "19.2.0",
    "typescript": "7.0.2",
    "universal-cookie": "7.2.2",
    "wdc-cube-remote-bridge": "file:../remote.bridge.typescript"
  }
}
