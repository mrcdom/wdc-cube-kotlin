{
  "$description": "The WDC Store's design tokens (W3C Design Tokens format). The single source: :store-scripts:generateDesignTokens writes StoreTokens.kt (this module), tokens.ts (the TypeScript remote client) and the landing page's CSS variables from it. Colors are #RRGGBB or #RRGGBBAA.",
  "color": {
    "$type": "color",
    "primary": { "$value": "#1B5E7B" },
    "onPrimary": { "$value": "#FFFFFF" },
    "primaryContainer": { "$value": "#D0E8F2" },
    "onPrimaryContainer": { "$value": "#001F2A" },
    "secondary": { "$value": "#4A6572" },
    "onSecondary": { "$value": "#FFFFFF" },
    "secondaryContainer": { "$value": "#CDE5F0" },
    "onSecondaryContainer": { "$value": "#051F2C" },
    "background": { "$value": "#F5F7FA" },
    "surface": { "$value": "#FFFFFF" },
    "onSurface": { "$value": "#1A1C1E" },
    "surfaceVariant": { "$value": "#E7EBF0" },
    "onSurfaceVariant": { "$value": "#42474E" },
    "error": { "$value": "#BA1A1A" },
    "onError": { "$value": "#FFFFFF" },
    "errorContainer": { "$value": "#FFDAD6" },
    "onErrorContainer": { "$value": "#410002" },
    "outline": { "$value": "#72787E" },
    "outlineVariant": { "$value": "#C2C7CE" },
    "price": { "$value": "#2E7D32" },
    "success": { "$value": "#2E7D32" },
    "successContainer": { "$value": "#B9F6CA" },
    "surfaceVariant40": { "$value": "#E7EBF066", "$description": "surfaceVariant at 40%" },
    "surfaceVariant50": { "$value": "#E7EBF080", "$description": "surfaceVariant at 50%" },
    "priceBackground": { "$value": "#2E7D321A", "$description": "price at 10%" },
    "whiteOverlay10": { "$value": "#FFFFFF1A", "$description": "on dark backgrounds" },
    "whiteOverlay15": { "$value": "#FFFFFF26" },
    "whiteOverlay20": { "$value": "#FFFFFF33" },
    "whiteOverlay50": { "$value": "#FFFFFF80" },
    "whiteOverlay85": { "$value": "#FFFFFFD9" },
    "toastBackground": { "$value": "#333333E6" }
  },
  "spacing": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "16px" },
    "xl": { "$value": "24px" },
    "xxl": { "$value": "32px" }
  },
  "radius": {
    "$type": "dimension",
    "xs": { "$value": "4px" },
    "sm": { "$value": "8px" },
    "md": { "$value": "12px" },
    "lg": { "$value": "18px" },
    "xl": { "$value": "20px" }
  },
  "fontSize": {
    "$type": "dimension",
    "caption": { "$value": "12px" },
    "body": { "$value": "14px" },
    "bodyLarge": { "$value": "16px" },
    "title": { "$value": "20px" },
    "headline": { "$value": "24px" },
    "display": { "$value": "28px" }
  },
  "fontWeight": {
    "$type": "fontWeight",
    "regular": { "$value": 400 },
    "medium": { "$value": 500 },
    "bold": { "$value": 700 }
  },
  "fontFamily": {
    "$type": "fontFamily",
    "base": { "$value": ["Roboto", "Helvetica", "Arial", "sans-serif"] }
  }
}
