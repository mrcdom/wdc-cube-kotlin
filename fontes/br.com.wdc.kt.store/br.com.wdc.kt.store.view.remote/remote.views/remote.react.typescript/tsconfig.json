{
  "compilerOptions": {
    "target": "ES2024",
    "lib": ["ES2024", "DOM"],
    "moduleResolution": "bundler",
    "jsx": "react",
    "experimentalDecorators": true,
    "isolatedModules": true,
    //"jsxImportSource": "preact"
    "paths": {
      "@root/*": ["./src/scripts/*"],
      "@wdc/remote-bridge-react": [
        "../../../../br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript.react/src/index.tsx"
      ],
      "@wdc/remote-bridge": [
        "../../../../br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript/src/index.ts"
      ],
      // The bridge packages have no node_modules of their own: their peer dependencies resolve to this client's.
      "react": ["./node_modules/@types/react"],
      "history": ["./node_modules/history"],
      "universal-cookie": ["./node_modules/universal-cookie"]
    }
  }
}
