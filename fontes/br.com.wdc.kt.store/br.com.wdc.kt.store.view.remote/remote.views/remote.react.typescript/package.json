{
  "name": "wdc-store-react",
  "license": "MIT",
  "author": "Marcelo Domingos <WeDoCode Consultoria LTDA>",
  "repository": {
    "type": "git",
    "url": "https://github.com/mrcdom/wdc-cube-kotlin.git",
    "directory": "fontes/br.com.wdc.kt.store/br.com.wdc.kt.store.view.remote/remote.views/remote.react.typescript"
  },
  "source": "src/index.html",
  "targets": {
    "default": {
      "distDir": "../../remote.host/src/main/resources/META-INF/resources"
    }
  },
  "alias": {
    "@root/*": "./src/scripts/$1",
    "@wdc/remote-bridge-react": "../../../../br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript.react/src/index.tsx",
    "@wdc/remote-bridge": "../../../../br.com.wdc.kt.framework/br.com.wdc.kt.framework.cube.remote/remote.bridge.typescript/src/index.ts",
    "react": "./node_modules/react",
    "history": "./node_modules/history",
    "universal-cookie": "./node_modules/universal-cookie"
  },
  "scripts": {
    "start": "parcel watch --public-url ./",
    "watch": "parcel watch --public-url ./",
    "clean:watch": "rm -rf .parcel-cache && find ../../remote.host/src/main/resources/META-INF/resources -maxdepth 1 -type f -delete && parcel watch --public-url ./",
    "build": "parcel build --public-url ./",
    "clean:build": "rm -rf .parcel-cache && find ../../remote.host/src/main/resources/META-INF/resources -maxdepth 1 -type f -delete && parcel build --public-url ./",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@types/react": "^19.0.3",
    "@types/react-dom": "^19.0.2",
    "parcel": "^2.13.3",
    "prettier": "^3.8.2",
    "process": "^0.11.10"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/icons-material": "^9.0.0",
    "@mui/material": "^9.0.0",
    "history": "^5.3.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "universal-cookie": "^7.2.2"
  }
}
