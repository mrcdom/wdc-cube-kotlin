# Runtime data — fontes/work is the backend working directory during development.
# Versioned: the work/config defaults (application.example.toml, logback.xml) and the work/deployment
# skeleton; application.toml is local (it holds a secret) and the rest is generated.
**/work/config/application.toml
**/work/data/
**/work/log/
**/work/tmp/
*.mv.db

